        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% ==========================================================\n%% NOVABANK ENTERPRISE AI PLATFORM\n%% ==========================================================\n\nsubgraph SRC[\&quot;Source Systems\&quot;]\n    CUST[\&quot;Customer System\&quot;]\n    ACC[\&quot;Account System\&quot;]\n    TXN[\&quot;Transaction System\&quot;]\n    LOAN[\&quot;Loan System\&quot;]\n    CRM[\&quot;CRM System\&quot;]\n    FRAUD[\&quot;Fraud Events\&quot;]\nend\n\nsubgraph ING[\&quot;Ingestion Layer\&quot;]\n    ADF[\&quot;Azure Data Factory\&quot;]\n    EH[\&quot;Azure Event Hub\&quot;]\nend\n\nsubgraph LAKE[\&quot;Azure Data Lake Gen2\&quot;]\n    BRONZE[\&quot;Bronze Layer&lt;br/&gt;Raw Data\&quot;]\n    SILVER[\&quot;Silver Layer&lt;br/&gt;Validated Data\&quot;]\n    GOLD[\&quot;Gold Layer&lt;br/&gt;Business Data\&quot;]\nend\n\nsubgraph DBX[\&quot;Azure Databricks Lakehouse\&quot;]\n    SPARK[\&quot;Spark Processing\&quot;]\n    DELTA[\&quot;Delta Lake\&quot;]\n    UC[\&quot;Unity Catalog\&quot;]\nend\n\nsubgraph DBT[\&quot;Analytics Engineering\&quot;]\n    STG[\&quot;dbt Staging\&quot;]\n    INT[\&quot;dbt Intermediate\&quot;]\n    MART[\&quot;dbt Marts\&quot;]\nend\n\nsubgraph GOLDMODELS[\&quot;Business Data Products\&quot;]\n\n    C360[\&quot;Customer360 Gold\&quot;]\n\n    FRAUDA[\&quot;Fraud Analytics\&quot;]\n\n    RISKA[\&quot;Risk Analytics\&quot;]\n\nend\n\nsubgraph ML[\&quot;Machine Learning Platform\&quot;]\n\n    FE[\&quot;Feature Engineering\&quot;]\n\n    MLFLOW[\&quot;MLflow\&quot;]\n\n    REG[\&quot;Model Registry\&quot;]\n\n    MON[\&quot;Model Monitoring\&quot;]\n\nend\n\nsubgraph GENAI[\&quot;Generative AI Platform\&quot;]\n\n    EMB[\&quot;Embeddings\&quot;]\n\n    VECTOR[\&quot;Vector Search\&quot;]\n\n    OPENAI[\&quot;Azure OpenAI\&quot;]\n\n    AGENTS[\&quot;AI Agents\&quot;]\n\nend\n\nsubgraph BI[\&quot;Reporting Layer\&quot;]\n\n    EXEC[\&quot;Executive Dashboard\&quot;]\n\n    FDASH[\&quot;Fraud Dashboard\&quot;]\n\n    RDASH[\&quot;Risk Dashboard\&quot;]\n\nend\n\nsubgraph SEC[\&quot;Security &amp; Governance\&quot;]\n\n    ENTRA[\&quot;Microsoft Entra ID\&quot;]\n\n    RBAC[\&quot;RBAC\&quot;]\n\n    KV[\&quot;Key Vault\&quot;]\n\n    RLS[\&quot;Row Level Security\&quot;]\n\n    CLS[\&quot;Column Level Security\&quot;]\n\nend\n\nsubgraph DEVOPS[\&quot;DevOps\&quot;]\n\n    GIT[\&quot;GitHub\&quot;]\n\n    ADO[\&quot;Azure DevOps\&quot;]\n\n    TF[\&quot;Terraform\&quot;]\n\n    DAB[\&quot;Databricks Asset Bundles\&quot;]\n\nend\n\n%% ==========================================================\n%% FLOWS\n%% ==========================================================\n\nCUST --&gt; ADF\nACC --&gt; ADF\nTXN --&gt; ADF\nLOAN --&gt; ADF\nCRM --&gt; ADF\n\nFRAUD --&gt; EH\n\nADF --&gt; BRONZE\nEH --&gt; BRONZE\n\nBRONZE --&gt; SPARK\n\nSPARK --&gt; SILVER\n\nSILVER --&gt; DELTA\n\nDELTA --&gt; GOLD\n\nGOLD --&gt; STG\n\nSTG --&gt; INT\n\nINT --&gt; MART\n\nMART --&gt; C360\nMART --&gt; FRAUDA\nMART --&gt; RISKA\n\nC360 --&gt; FE\nFRAUDA --&gt; FE\nRISKA --&gt; FE\n\nFE --&gt; MLFLOW\n\nMLFLOW --&gt; REG\n\nREG --&gt; MON\n\nC360 --&gt; EMB\nFRAUDA --&gt; EMB\nRISKA --&gt; EMB\n\nEMB --&gt; VECTOR\n\nVECTOR --&gt; OPENAI\n\nOPENAI --&gt; AGENTS\n\nC360 --&gt; EXEC\n\nFRAUDA --&gt; FDASH\n\nRISKA --&gt; RDASH\n\nGIT --&gt; ADO\n\nADO --&gt; TF\n\nTF --&gt; DAB\n\nENTRA --&gt; RBAC\n\nRBAC --&gt; KV\n\nKV --&gt; UC\n\nUC --&gt; SPARK&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9XpSAp1vpMC_aPZ6qqXV-1">
